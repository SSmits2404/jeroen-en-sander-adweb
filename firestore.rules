rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function budgetBookDoc(bookId) {
      return get(/databases/$(database)/documents/budgetBooks/$(bookId));
    }

    function budgetBookExists(bookId) {
      return exists(/databases/$(database)/documents/budgetBooks/$(bookId));
    }

    function canReadBudgetBook(book) {
      return isSignedIn() && (
        book.data.ownerId == request.auth.uid ||
        (book.data.memberIds is list && request.auth.uid in book.data.memberIds)
      );
    }

    function canEditBudgetBook(book) {
      return isSignedIn() && book.data.ownerId == request.auth.uid;
    }

    match /budgetBooks/{bookId} {
      allow read: if canReadBudgetBook(resource);

      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.description is string
        && request.resource.data.archived is bool;

      allow update: if canEditBudgetBook(resource)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.description is string
        && request.resource.data.archived is bool;

      allow delete: if false;
    }

    match /categories/{categoryId} {
      allow read: if isSignedIn()
        && resource.data.budgetBookId is string
        && budgetBookExists(resource.data.budgetBookId)
        && canReadBudgetBook(budgetBookDoc(resource.data.budgetBookId));

      allow create: if isSignedIn()
        && request.resource.data.budgetBookId is string
        && budgetBookExists(request.resource.data.budgetBookId)
        && canEditBudgetBook(budgetBookDoc(request.resource.data.budgetBookId))
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.budget is number
        && request.resource.data.budget >= 0;

      allow update: if isSignedIn()
        && resource.data.budgetBookId is string
        && request.resource.data.budgetBookId == resource.data.budgetBookId
        && budgetBookExists(resource.data.budgetBookId)
        && canEditBudgetBook(budgetBookDoc(resource.data.budgetBookId))
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.budget is number
        && request.resource.data.budget >= 0;

      allow delete: if false;
    }

    match /transactions/{transactionId} {
      allow read: if isSignedIn()
        && resource.data.budgetBookId is string
        && budgetBookExists(resource.data.budgetBookId)
        && canReadBudgetBook(budgetBookDoc(resource.data.budgetBookId));

      allow create: if isSignedIn()
        && request.resource.data.budgetBookId is string
        && budgetBookExists(request.resource.data.budgetBookId)
        && canEditBudgetBook(budgetBookDoc(request.resource.data.budgetBookId))
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0
        && request.resource.data.amount is number
        && request.resource.data.amount != 0
        && (request.resource.data.type == 'expense' || request.resource.data.type == 'income');

      allow update: if isSignedIn()
        && resource.data.budgetBookId is string
        && request.resource.data.budgetBookId == resource.data.budgetBookId
        && budgetBookExists(resource.data.budgetBookId)
        && canEditBudgetBook(budgetBookDoc(resource.data.budgetBookId))
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0
        && request.resource.data.amount is number
        && request.resource.data.amount != 0
        && (request.resource.data.type == 'expense' || request.resource.data.type == 'income');

      allow delete: if false;
    }

    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }
  }
}